# Optional startup settings. Copy to .env.local; keep real addresses out of Git.
# Unset values use port 19337, http://localhost:<port>, and automatic watching.
# A Bot in another network namespace needs a reachable URL here and in its catalog settings.
# PLUGIN_SOURCE_PORT=19337
# PLUGIN_SOURCE_PUBLIC_URL=http://localhost:19337
# PLUGIN_SOURCE_WATCH=1
# PI_IM_BOT_SOURCE=../pi-im-bot
