{
  "name": "pi-im-bot-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/pack.ts",
    "source": "bun scripts/dev-source.ts",
    "docs:sync": "bun scripts/sync-docs.ts",
    "format": "prettier --write src scripts plugins tests package.json tsconfig.json",
    "format:check": "prettier --check src scripts plugins tests package.json tsconfig.json"
  },
  "dependencies": {
    "hono": "4.13.17",
    "@hono/standard-validator": "0.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "bun": "1.4.4",
    "typescript": "7.0.2",
    "prettier": "3.6.2"
  },
  "trustedDependencies": [
    "bun"
  ]
}
