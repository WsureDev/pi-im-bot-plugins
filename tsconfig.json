{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@pi-im-bot/plugin-sdk": ["../pi-im-bot/src/plugins/sdk/index.ts"] }
  },
  "include": ["src", "scripts", "plugins/*/src", "tests"]
}
